// Rosé Pine Moon: three floating islands (workspaces · clock · status)
{
  "layer": "top",
  "position": "top",
  "height": 36,
  "spacing": 0,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,

  "modules-left": ["hyprland/workspaces", "hyprland/window", "mpris"],
  "modules-center": ["clock", "custom/weather"],
  "modules-right": [
    "tray",
    "group/hardware",
    "custom/updates",
    "pulseaudio",
    "network",
    "bluetooth",
    "hyprland/language",
    "idle_inhibitor",
    "custom/notification",
    "custom/power"
  ],

  // Workspaces as dots; the active one becomes a wide pill (see style.css).
  "hyprland/workspaces": {
    "format": "",
    "on-click": "activate",
    "sort-by-number": true,
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
  },

  "hyprland/window": {
    "format": "{}",
    "max-length": 48,
    "separate-outputs": true
  },

  "mpris": {
    "format": "{status_icon} {title}",
    "format-paused": "{status_icon} <i>{title}</i>",
    "status-icons": { "playing": "󰏤", "paused": "󰐊" },
    "max-length": 36,
    "tooltip-format": "{artist} · {title}"
  },

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%A %d %B · %H:%M}",
    "tooltip-format": "<tt><big>{calendar}</big></tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "",
      "on-scroll": 1,
      "format": {
        "months":   "<span color='#c4a7e7'><b>{}</b></span>",
        "weekdays": "<span color='#908caa'>{}</span>",
        "today":    "<span color='#ea9a97'><b><u>{}</u></b></span>"
      }
    },
    "actions": { "on-scroll-up": "shift_up", "on-scroll-down": "shift_down" }
  },

  "custom/weather": {
    "exec": "~/.config/waybar/scripts/weather.sh",
    "return-type": "json",
    "interval": 1800,
    "on-click": "xdg-open https://wttr.in"
  },

  // Hardware: CPU always visible, hover to slide out memory, temperature and disk.
  "group/hardware": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 300,
      "children-class": "hw-child",
      "transition-left-to-right": false
    },
    "modules": ["cpu", "memory", "temperature", "disk"]
  },

  "cpu": {
    "format": "󰻠 {usage}%",
    "interval": 3,
    "states": { "warning": 70, "critical": 90 },
    "on-click": "ghostty -e btop"
  },

  "memory": {
    "format": "󰍛 {percentage}%",
    "interval": 5,
    "states": { "warning": 75, "critical": 90 },
    "tooltip-format": "{used:0.1f} / {total:0.1f} GiB"
  },

  "temperature": {
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp1_input",
    "critical-threshold": 85,
    "format": "󰔏 {temperatureC}°",
    "interval": 5
  },

  "disk": {
    "format": "󰋊 {percentage_used}%",
    "path": "/",
    "interval": 60,
    "tooltip-format": "{used} / {total}"
  },

  "custom/updates": {
    "exec": "~/.config/waybar/scripts/checkupdates.sh",
    "return-type": "json",
    "interval": 3600,
    "signal": 20,
    "on-click": "ghostty -e bash -c 'yay -Syu; echo Done; read'"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"], "headphone": "󰋋" },
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "on-click-right": "swayosd-client --output-volume mute-toggle"
  },

  "network": {
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format-wifi": "{essid} · {signalStrength}%\n{ipaddr}",
    "tooltip-format-ethernet": "{ifname} · {ipaddr}\n {bandwidthDownBytes}   {bandwidthUpBytes}",
    "on-click": "nm-connection-editor"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-off": "󰂲",
    "format-connected": "󰂱",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "blueman-manager"
  },

  "hyprland/language": {
    "format": "{short}"
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": { "activated": "󰅶", "deactivated": "󰾪" },
    "tooltip-format-activated": "Sin bloqueo automático",
    "tooltip-format-deactivated": "Bloqueo automático activo"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  },

  "custom/notification": {
    "exec": "swaync-client -swb",
    "return-type": "json",
    "escape": true,
    "format": "{icon}",
    "format-icons": {
      "notification": "󰂚",
      "none": "󰂜",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛",
      "inhibited-notification": "󰂚",
      "inhibited-none": "󰂜",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰂛"
    },
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw"
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip": false,
    "on-click": "~/bin/powermenu.sh"
  }
}
