* {
    bg:       #24273a;
    bg-alt:   #363a4f;
    fg:       #cad3f5;
    fg-alt:   #a5adcb;
    blue:     #8aadf4;
    lavender: #b7bdf8;
    red:      #ed8796;

    background-color: @bg;
    text-color:       @fg;
    border-color:     @blue;
}

window {
    width:            600px;
    border:           2px;
    border-radius:    12px;
    padding:          20px;
    background-color: @bg;
}

mainbox {
    spacing: 12px;
}

inputbar {
    children: [prompt, entry];
    border:           2px;
    border-radius:    8px;
    padding:          8px 12px;
    background-color: @bg-alt;
}

prompt {
    text-color:       @blue;
    background-color: transparent;
}

entry {
    placeholder:       "Search...";
    placeholder-color: @fg-alt;
    background-color:  transparent;
}

listbox {
    spacing: 4px;
}

listview {
    lines:    8;
    columns:  1;
    fixed-height: true;
    spacing:  4px;
}

element {
    padding:       8px 12px;
    border-radius: 8px;
}

element selected {
    background-color: @blue;
    text-color:       @bg;
}

element-icon {
    size: 24px;
    padding: 0 8px 0 0;
}

element-text {
    vertical-align: 0.5;
}
