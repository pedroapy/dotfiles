function npmversion() {
  npm v "$1" | grep -A 50 dist-tags | grep -vE "published|dist-tags"
}

function key() {
  eval "$(ssh-agent -s)" && ssh-add ~/.ssh/"$1"
}

# Create directory and cd into it
mkcd() { mkdir -p "$1" && cd "$1"; }

# Kill process by port
killport() {
  local pids
  pids=$(lsof -ti :"$1" 2>/dev/null || ss -tlnp | grep :"$1" | grep -oP 'pid=\K\d+')
  if [[ -n "$pids" ]]; then
    echo "$pids" | xargs kill -9
    echo "Killed process(es) on port $1"
  else
    echo "No process found on port $1"
  fi
}

# Extract any archive
extract() {
  if [ -f "$1" ]; then
    case "$1" in
      *.tar.bz2) tar xjf "$1" ;;
      *.tar.gz)  tar xzf "$1" ;;
      *.tar.xz)  tar xJf "$1" ;;
      *.bz2)     bunzip2 "$1" ;;
      *.rar)     unrar x "$1" ;;
      *.gz)      gunzip "$1" ;;
      *.tar)     tar xf "$1" ;;
      *.tbz2)    tar xjf "$1" ;;
      *.tgz)     tar xzf "$1" ;;
      *.zip)     unzip "$1" ;;
      *.Z)       uncompress "$1" ;;
      *.7z)      7z x "$1" ;;
      *.zst)     zstd -d "$1" ;;
      *)         echo "'$1' cannot be extracted" ;;
    esac
  else
    echo "'$1' is not a valid file"
  fi
}

# fzf-powered git branch switcher
fbr() {
  local branch
  branch=$(git branch --all | fzf --height=40% --reverse | sed 's/^\*//;s/^ *//;s|remotes/origin/||')
  [ -n "$branch" ] && git switch "$branch"
}

# fzf-powered directory changer
fcd() {
  local dir
  dir=$(fd --type d --hidden --exclude .git | fzf --height=40% --reverse --preview 'eza --tree --level=1 {}')
  [ -n "$dir" ] && cd "$dir"
}

# fzf-powered file opener
fo() {
  local file
  file=$(fd --type f --hidden --exclude .git | fzf --height=40% --reverse --preview 'bat --color=always --style=numbers --line-range :200 {}')
  [ -n "$file" ] && ${EDITOR:-vim} "$file"
}
