# ── Font ────────────────────────────────────────
font-family = JetBrainsMono Nerd Font
font-size = 13

# ── Theme ───────────────────────────────────────
theme = Catppuccin Macchiato

# ── Window ──────────────────────────────────────
window-padding-x = 10
window-padding-y = 8
window-decoration = false
background-opacity = 0.92
background-blur-radius = 20
confirm-close-surface = false

# ── Cursor ──────────────────────────────────────
cursor-style = block
cursor-style-blink = true

# ── Scrollback ──────────────────────────────────
scrollback-limit = 10000

# ── Clipboard ──────────────────────────────────
clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard

# ── Keybindings ─────────────────────────────────
# Clipboard
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard

# Windows & tabs
keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+q=close_window

# Tab navigation
keybind = ctrl+shift+right=next_tab
keybind = ctrl+shift+left=previous_tab
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab
keybind = ctrl+shift+1=goto_tab:1
keybind = ctrl+shift+2=goto_tab:2
keybind = ctrl+shift+3=goto_tab:3
keybind = ctrl+shift+4=goto_tab:4
keybind = ctrl+shift+5=goto_tab:5
keybind = ctrl+shift+6=goto_tab:6
keybind = ctrl+shift+7=goto_tab:7
keybind = ctrl+shift+8=goto_tab:8
keybind = ctrl+shift+9=goto_tab:9

# Splits (Cmd+D / Cmd+Shift+D en iTerm2)
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+e=new_split:down
keybind = ctrl+shift+x=close_surface
keybind = ctrl+shift+z=toggle_split_zoom
keybind = ctrl+shift+equal=equalize_splits

# Split navigation (Cmd+Opt+arrows en iTerm2)
keybind = ctrl+alt+left=goto_split:left
keybind = ctrl+alt+right=goto_split:right
keybind = ctrl+alt+up=goto_split:up
keybind = ctrl+alt+down=goto_split:down
keybind = ctrl+shift+p=goto_split:previous

# Font size (Cmd +/-/0 en iTerm2)
keybind = ctrl+shift+plus=increase_font_size:1
keybind = ctrl+shift+minus=decrease_font_size:1
keybind = ctrl+shift+zero=reset_font_size

# Misc
keybind = ctrl+shift+k=clear_screen
keybind = ctrl+shift+f=toggle_fullscreen
keybind = ctrl+shift+r=reload_config
keybind = ctrl+shift+i=inspector:toggle
