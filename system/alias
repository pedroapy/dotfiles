# Interactive-only shortcuts. Claude Code runs its Bash commands through this
# profile (CLAUDECODE=1), so agents must get the standard tools, not these.
if [[ -z $CLAUDECODE ]]; then
  alias update="brew upgrade"

  # Modern CLI replacements
  alias ls="eza --icons --group-directories-first"
  alias ll="eza -la --icons --group-directories-first --git"
  alias lt="eza --tree --level=2 --icons"
  alias cat="bat --paging=never"
  alias du="dust"
  alias df="duf"
  alias top="btop"
fi

# Git
alias g="git"
alias gs="git status"
alias ga="git add"
alias gc="git commit"
alias gp="git push"
alias gd="git diff"
alias gl="git log --oneline --graph --decorate -20"
alias gpl="git pull --rebase"
alias gst="git stash"
alias gsp="git stash pop"
alias lg="lazygit"

# Personal
alias tasks="cd ~/workspace/tasks && claude"

# Navigation — jump up N directories (... = up two, etc.)
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."
