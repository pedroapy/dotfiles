{
  "permissions": {
    "allow": [
      "Bash(source:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/dotfiles/scripts/claude-statusline.sh"
  },
  "effortLevel": "high"
}
